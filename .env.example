# ---------------------------------------------------------------
# Star Fighter — AI before/after configuration
# Copy to .env.local for local dev; set the same vars in Vercel
# (Project Settings -> Environment Variables) for deployment.
#
# With NO keys set, the app still runs fully: the visualization
# uses the on-device landmark-warp simulation and tells the user
# photoreal AI is not configured. Add a key for the real magic.
# ---------------------------------------------------------------

# Primary provider: Google Gemini image editing (Nano Banana family).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Which Gemini image model to use. Default: gemini-2.5-flash-image
# Point this at a newer Nano Banana release when your key has access
# (e.g. gemini-3-pro-image-preview).
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# Fallback provider: FLUX.1 Kontext (Black Forest Labs)
# https://api.bfl.ai — used automatically if Gemini fails or is unset.
BFL_API_KEY=
BFL_MODEL=flux-kontext-pro

# Force a provider: "gemini" | "flux" (optional; auto-detects by default)
AI_PROVIDER=
