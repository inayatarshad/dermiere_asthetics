# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated at postinstall from node_modules (scripts/setup-assets.mjs)
/public/mediapipe/wasm

# local dev booth inbox (T1 fallback store)
/.booth-dev-store
/.vybero-dev-store
/.portal-dev-store

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# dev database (file-backed Postgres twin)
.dev-db/

